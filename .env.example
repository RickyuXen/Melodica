# Melodica — copy to `.env` and fill in values.
#
# Dev only (`npm run tauri:dev`): the Rust app loads this file automatically.
# Downloaded / release builds ignore `.env` and require a key in Settings.
#
# A Settings key always wins over MELODICA_TRANSLATE_API_KEY when both exist.

# Required for lyric translation in development (Google AI Studio / Gemini)
# https://aistudio.google.com/apikey
MELODICA_TRANSLATE_API_KEY=

# Optional — defaults shown
MELODICA_TRANSLATE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MELODICA_TRANSLATE_MODEL=gemini-3.1-flash-lite
